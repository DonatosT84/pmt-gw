<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Payment gateway demo{% endblock %}</title>
        <style>
            :root { color-scheme: light dark; }
            body { font: 16px/1.5 system-ui, sans-serif; margin: 0; background: #f6f7f9; color: #1a1a1a; }
            main { max-width: 34rem; margin: 3rem auto; padding: 2rem; background: #fff; border-radius: 12px;
                   box-shadow: 0 1px 3px rgba(0,0,0,.08); }
            h1 { margin-top: 0; font-size: 1.4rem; }
            label { display: block; font-weight: 600; margin: 1rem 0 .25rem; }
            input[type=text], input[type=email], textarea, select {
                width: 100%; padding: .55rem .7rem; border: 1px solid #cbd0d8; border-radius: 8px;
                font: inherit; box-sizing: border-box; background: #fff; color: inherit; }
            textarea { min-height: 4rem; resize: vertical; }
            button { margin-top: 1.5rem; padding: .6rem 1.2rem; border: 0; border-radius: 8px;
                     background: #4f46e5; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
            .help { font-size: .85rem; color: #666; margin-top: .2rem; }
            .error { color: #b91c1c; font-size: .9rem; margin-top: .3rem; }
            .flash { padding: .7rem 1rem; border-radius: 8px; margin-bottom: 1rem; }
            .flash-success { background: #dcfce7; color: #166534; }
            .flash-error { background: #fee2e2; color: #991b1b; }
            .panel { padding: 1rem; border-radius: 8px; margin-top: 1rem; }
            .panel-succeeded { background: #dcfce7; color: #166534; }
            .panel-failed { background: #fee2e2; color: #991b1b; }
            .panel-processing, .panel-pending { background: #fef9c3; color: #854d0e; }
            dl { display: grid; grid-template-columns: auto 1fr; gap: .3rem 1rem; margin: .5rem 0 0; }
            dt { font-weight: 600; }
            dd { margin: 0; }
            a { color: #4f46e5; }
            .muted { color: #666; font-size: .9rem; }
        </style>
        {% block javascripts %}{% endblock %}
    </head>
    <body>
        <main>
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="flash flash-{{ type }}">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
    </body>
</html>
