{% extends 'base.html.twig' %}

{% block title %}Default payment provider{% endblock %}

{% block body %}
    <h1>Default payment provider</h1>

    <p>Current default: <strong>{{ currentProvider }}</strong></p>
    <p class="muted">
        Changing this affects <em>new</em> payments only. Payments already created keep the
        provider they were started with.
    </p>

    {{ form_start(form) }}
        {{ form_errors(form) }}
        {{ form_row(form.provider) }}
        <button type="submit">Save</button>
    {{ form_end(form) }}
{% endblock %}
