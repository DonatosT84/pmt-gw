# Copy the secret-bearing entries into .env.local and fill in real values.
#   cp .env.example .env.local   # then edit .env.local
# .env holds the non-secret committed defaults; .env.local overrides them and is git-ignored.

# --- Application ---------------------------------------------------------------
APP_ENV=dev
# 32+ random hex chars: `openssl rand -hex 16`
APP_SECRET=0123456789abcdef0123456789abcdef
APP_BASE_URL=http://localhost:8000

# --- Database ----------------------------------------------------------------
# One SQLite file per environment under var/.
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"

# --- Admin (HTTP Basic on /admin) -------------------------------------------
ADMIN_USERNAME=admin
# bcrypt hash of the admin password (NOT the password itself):
#   docker compose run --rm app php -r "echo password_hash('s3cret', PASSWORD_BCRYPT), PHP_EOL;"
ADMIN_PASSWORD_HASH='$2y$13$exampleexampleexampleeuxampleexampleexampleexampleexampl'

# --- Default provider ------------------------------------------------------
# Applied only until a provider is saved via /admin/payment-provider.
PAYMENT_DEFAULT_PROVIDER=stripe

# --- Stripe (test mode) ---------------------------------------------------
# https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# --- PayPal (sandbox) ---------------------------------------------------
# https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=Axxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_CLIENT_SECRET=Exxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYPAL_BASE_URI=https://api-m.sandbox.paypal.com
